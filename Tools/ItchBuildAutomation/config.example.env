# Copy this file to config.local.env by running install.sh. The local copy is ignored by Git.

# Required before upload is enabled. The itch.io project page must already exist.
ITCH_TARGET="username/game-slug"
ITCH_CHANNEL="html5-development"

# Set to 1 only when successful builds should be uploaded automatically.
ITCH_UPLOAD_ENABLED="0"

# Optional. When empty, the exact version in ProjectSettings/ProjectVersion.txt is used.
UNITY_EXECUTABLE=""

# Repository-relative Unity project directory. This project is at the repository root.
UNITY_PROJECT_RELATIVE_PATH="."

# This repository's existing build entry point builds WebGL.
BUILD_TARGET="WebGL"
BUILD_PRODUCT_NAME="Proto"
UNITY_BUILD_METHOD="Game.Editor.WebBuild.PerformBuild"

# Optional absolute path. The default is a persistent sibling named
# <repository>-itch-build-worktree.
WORKTREE_PATH=""

# Do not store BUTLER_API_KEY here. Run `butler login` or provide the variable
# through an existing secure process environment without writing it to logs.
