#!/usr/bin/env bash

set -u

hook_name="${1:-}"
if [[ -z "$hook_name" ]]; then
    printf 'usage: run-legacy-hook HOOK-NAME [ARGS...]\n' >&2
    exit 2
fi
shift

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
common_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)" || exit 1
legacy_hook="$common_dir/hooks/$hook_name"

if [[ -x "$legacy_hook" ]]; then
    exec "$legacy_hook" "$@"
fi

# Git LFS normally installs legacy hooks under .git/hooks. Keep a safe fallback
# for repositories that gain LFS attributes after this tracked hook is installed.
if [[ -f "$repo_root/.gitattributes" ]] && grep -q 'filter=lfs' "$repo_root/.gitattributes" && \
   command -v git-lfs >/dev/null 2>&1; then
    exec git lfs "$hook_name" "$@"
fi

exit 0
